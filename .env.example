# myAgent — environment configuration
#
# Copy this file to .env in the project root and fill in the values you
# need. myAgent auto-loads .env at startup (precedence: shell env wins
# over .env, so anything you `export` first is preserved).
#
# Alternative locations: ~/.config/myagent/.env  (loaded if no project .env).
#
# Only the providers you actually use need keys. Ollama needs no key.
# ---------------------------------------------------------------------------

# === LLM providers ==========================================================

# Anthropic (Claude). Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI. Get one at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# Optional: OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: OPENAI_ORG=org_...

# Google (Gemini). Get one at https://aistudio.google.com/app/apikey
# Also used by tools/search/backends/google.py for the grounded-search
# fallback in the auto cascade.
# GOOGLE_API_KEY=AIza...

# AWS Bedrock (alternative path for Anthropic models, billed via AWS).
# Uses the standard boto3 credential chain — these are optional overrides.
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# ANTHROPIC_BEDROCK_BASE_URL=

# Ollama (local). No key. Just point at the daemon if it's not on default port.
# OLLAMA_BASE_URL=http://localhost:11434

# === Search backends ========================================================

# Tavily (paid commercial web search). Only needed when forcing
# `--backend tavily` or putting it in your cascade.
# TAVILY_API_KEY=tvly-...

# YaCy local index (free, self-hosted). Defaults to localhost:8090.
# YACY_BASE_URL=http://localhost:8090
# BANNA_YACY_VERIFY=cacheonly         # verify mode: nocache | iffresh | ifexist | cacheonly
# BANNA_YACY_RESOURCE=local           # local index only, or 'global' for P2P

# Default web-search backend when the agent calls `search` without a
# `backend=` arg. "auto" = cascade YaCy → DuckDuckGo → Google.
# MYAGENT_SEARCH_BACKEND=auto

# Override the auto cascade order:
# MYAGENT_SEARCH_CASCADE=yacy,duckduckgo,google

# === Substrate ==============================================================

# Path to your Banna engine checkout. The CLI auto-discovers common
# locations (myAgentsWorld/myWorld/finance-agent/banna, ~/code/banna,
# etc.); set this only when you have it somewhere unusual.
# BANNA_ROOT=/path/to/banna

# === myAgent runtime ========================================================

# Override where persistent memory is stored. Defaults to
# ~/.config/myagent/memory.jsonl.
# MYAGENT_MEMORY_PATH=/path/to/memory.jsonl

# Default provider/model when myAgent is launched without --provider/--model.
# Same as the corresponding CLI flags; CLI flags win over env.
# MYAGENT_PROVIDER=anthropic
# MYAGENT_MODEL=claude-opus-4-5-20251101

# === Search-source registry =================================================

# Override the YaCy trusted-domain config (defaults to ./config/search_sources.yml).
# MYAGENT_SEARCH_SOURCES=/path/to/search_sources.yml
